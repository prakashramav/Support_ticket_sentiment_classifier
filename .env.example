# Environment Variables Template
# Copy this file to .env or .env.local

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=info

# Model Paths (optional overrides, defaults to project artifacts/)
BERT_MODEL_DIR=artifacts/bert
TFIDF_MODEL_PATH=artifacts/tfidf/tfidf_logistic_regression.joblib

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
